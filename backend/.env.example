# Database URL Configuration (SQLite or PostgreSQL / Neon DB)
# For local SQLite: sqlite+aiosqlite:///./pinnacle.db
# For PostgreSQL (Neon): postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./pinnacle.db

# JWT Authentication Secret Key (Change this in production)
SECRET_KEY=super-secret-life-rpg-key-change-in-production-2026

# Token Algorithm & Expiry
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
